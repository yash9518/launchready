# Copy this file to .env and add ONE key to switch AI assist on. Without a key, every
# deterministic check still runs; judgment-only rules go to a person.

# Google: Gemini API key (starts with AIza) or Google Cloud / Vertex AI express key (starts with AQ.)
GEMINI_API_KEY=
# Optional: pin a model (default gemini-2.5-flash, with automatic fallback to newer Gemini models)
# GEMINI_MODEL=gemini-2.5-flash

# Or Anthropic / OpenAI instead:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Force a provider (gemini | anthropic | openai | none):
# LLM_PROVIDER=gemini
